{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plateau-gaia-bfa values",
  "type": "object",
  "required": ["config"],
  "properties": {
    "global": {
      "type": "object",
      "description": "Injected by umbrella/parent charts; accepted as-is."
    },
    "enabled": {
      "type": "boolean",
      "description": "Umbrella dependency condition flag (<alias>.enabled); unused by the chart itself."
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "config": {
      "type": "object",
      "required": ["solutionSlug", "environmentSlug"],
      "properties": {
        "solutionSlug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "environmentSlug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": ["string", "number"] },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicas": { "type": "integer", "minimum": 0 },
    "containerPort": { "type": "integer" },
    "existingSecret": { "type": "string" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "resources": { "type": "object" },
    "ipa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": ["string", "number"] },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "targetPort": { "type": "integer" }
          }
        },
        "resources": { "type": "object" },
        "startupProbe": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "pdp": {
          "type": "object",
          "properties": {
            "policy": {
              "type": "object",
              "properties": {
                "domainId": { "type": "string" },
                "policyPackageId": { "type": "string" },
                "packageVersion": { "type": "string" }
              }
            },
            "policies": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "existingSecret": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "annotations": { "type": "object" },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "pathType": { "type": "string" }
            }
          }
        }
      }
    },
    "trustcerts": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "certs": { "type": "object" },
        "configmaps": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "conjur": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "kafka": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        },
        "secret-key-values": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
